# smart_guard.py
# المراقب الصامت - فحص وتصحيح قبل حفظ الهاتف


from difflib import SequenceMatcher


# ==================================
# تنظيف النصوص
# ==================================

def clean_text(value):

    if value is None:
        return ""

    return str(value).strip()



# ==================================
# توحيد المقاسات
# ==================================

def normalize_size(size):

    size = clean_text(size)

    size = size.replace(",", ".")

    try:
        return f"{float(size):.2f}"

    except:

        return size



# ==================================
# البحث عن هاتف مشابه
# ==================================

def find_similar_phone(db_data, phone):

    phone = clean_text(phone).lower()

    matches = []


    for size, panels in db_data.items():

        for panel, sensors in panels.items():

            for sensor, data in sensors.items():

                models = data.get(
                    "models",
                    []
                )


                for model in models:

                    score = SequenceMatcher(
                        None,
                        phone,
                        str(model).lower()
                    ).ratio()


                    if score >= 0.80:

                        matches.append(
                            {
                                "model": model,
                                "size": size,
                                "panel": panel,
                                "sensor": sensor,
                                "score": score
                            }
                        )


    return matches



# ==================================
# البحث عن مواصفات قريبة
# ==================================

def suggest_group(db_data, size, panel, sensor):


    size = normalize_size(size)


    suggestions = []


    for s, panels in db_data.items():


        try:

            diff = abs(
                float(s) -
                float(size)
            )

        except:

            continue



        if diff <= 0.03:


            for p, sensors in panels.items():


                for se in sensors:


                    suggestions.append(
                        {
                            "size": s,
                            "panel": p,
                            "sensor": se
                        }
                    )


    return suggestions



# ==================================
# الفحص قبل الحفظ
# ==================================

def check_before_save(
    db_data,
    size,
    panel,
    sensor,
    phone
):


    size = normalize_size(size)

    panel = clean_text(panel)

    sensor = clean_text(sensor)

    phone = clean_text(phone)



    # فحص وجود هاتف مشابه

    similar = find_similar_phone(
        db_data,
        phone
    )


    if similar:


        best = similar[0]


        if (

            best["size"] != size
            or
            best["panel"] != panel
            or
            best["sensor"] != sensor

        ):


            return False, (

                "⚠️ المراقب الصامت: "
                f"وجد هاتف قريب ({best['model']})\n"
                f"المواصفات المسجلة:\n"
                f"📏 {best['size']} | "
                f"📺 {best['panel']} | "
                f"👁️ {best['sensor']}"

            )



    # فحص مجموعة قريبة

    suggestions = suggest_group(
        db_data,
        size,
        panel,
        sensor
    )


    if suggestions:


        for item in suggestions:


            if (

                item["panel"] != panel
                or
                item["sensor"] != sensor

            ):


                return False, (

                    "⚠️ توجد مجموعة قريبة "
                    "لكن المواصفات مختلفة.\n"
                    f"المقترح:\n"
                    f"📏 {item['size']} | "
                    f"📺 {item['panel']} | "
                    f"👁️ {item['sensor']}"

                )



    return True, "✅ البيانات سليمة"



# ==================================
# تنظيف البيانات
# ==================================

def clean_database(db_data):

    removed = 0


    for size, panels in db_data.items():

        for panel, sensors in panels.items():

            for sensor, data in sensors.items():


                if "models" in data:


                    old = data["models"]


                    new = list(
                        dict.fromkeys(
                            [
                                clean_text(x)
                                for x in old
                                if clean_text(x)
                            ]
                        )
                    )


                    removed += len(old) - len(new)


                    data["models"] = new



    return db_data, removed
